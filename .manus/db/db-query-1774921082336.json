{
  "query": "\n-- Verificar dias lançados com data > hoje (31/03) em meses futuros ou dias futuros de março\nSELECT \n  empresaSlug,\n  data,\n  cat9,\n  CAST(cat1 AS DECIMAL(10,2)) + CAST(cat2 AS DECIMAL(10,2)) + CAST(cat3 AS DECIMAL(10,2)) + \n  CAST(cat4 AS DECIMAL(10,2)) + CAST(cat5 AS DECIMAL(10,2)) + CAST(cat6 AS DECIMAL(10,2)) + \n  CAST(cat7 AS DECIMAL(10,2)) + CAST(cat8 AS DECIMAL(10,2)) as total_sem_cat9\nFROM faturamentos\nWHERE empresaSlug IN ('MORUMBI', 'MASCOTE')\n  AND (\n    data > '2026-03-31'\n    OR (data LIKE '2026-03-%' AND CAST(SUBSTRING(data, 9, 2) AS UNSIGNED) > 31)\n  )\nORDER BY empresaSlug, data\nLIMIT 20;\n",
