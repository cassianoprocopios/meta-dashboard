  "query": "\n-- Verificar dias futuros do Morumbi e Mascote (a partir de hoje dia 19)\nSELECT \n  empresaSlug,\n  data,\n  ROUND(CAST(cat1 AS DECIMAL) + CAST(cat2 AS DECIMAL) + CAST(cat3 AS DECIMAL) + \n        CAST(cat4 AS DECIMAL) + CAST(cat5 AS DECIMAL) + CAST(cat6 AS DECIMAL) + \n        CAST(cat7 AS DECIMAL) + CAST(cat8 AS DECIMAL) + CAST(cat9 AS DECIMAL), 2) as total,\n  cat9,\n  lancadoPor\nFROM faturamentos\nWHERE empresaSlug IN ('barbiero-morumbi', 'barbiero-mascote')\n  AND data >= '2026-05-19'\nORDER BY empresaSlug, data;\n",
