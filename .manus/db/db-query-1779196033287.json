  "query": "\n-- Dias lançados por unidade em maio/2026\nSELECT \n  empresaSlug,\n  GROUP_CONCAT(data ORDER BY data) as diasLancados,\n  COUNT(*) as totalDias\nFROM faturamentos\nWHERE empresaSlug IN ('barbiero-morumbi', 'barbiero-mascote', 'barbiero-seraphine')\n  AND data BETWEEN '2026-05-01' AND '2026-05-31'\nGROUP BY empresaSlug\nORDER BY empresaSlug;\n",
