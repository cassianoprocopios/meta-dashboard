# Runtime
NODE_ENV=production
PORT=3000
TZ=America/Sao_Paulo

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Application session signing; generate a new random value for each environment
JWT_SECRET=replace-with-a-long-random-secret

# Local authentication / migration ownership
OWNER_OPEN_ID=local_owner

# Storage: use s3 for Cloudflare R2; manus is legacy-only during migration
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=meta-dashboard
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# Optional public base URL. Leave empty to use signed URLs.
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Transactional email / password recovery (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Meta Dashboard <noreply@your-domain.example>
NOTIFICATION_EMAIL_TO=owner@your-domain.example

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CRON_SECRET_TOKEN=replace-with-a-random-cron-token

# Legacy Manus-only variables. Do not configure these in the independent environment.
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=
